{
  "name": "@multitv/workspace",
  "version": "0.1.0",
  "description": "Multi-TV Hello World - Monorepo for building TV apps across Vega, Expo TV, and mobile platforms",
  "scripts": {
    "clean": "pnpm -r run clean ; rm -rf node_modules",
    "vega:build": "pnpm --filter @multitv/vega run build:debug",
    "vega:vvd:mseries": "pnpm --filter @multitv/vega run vvd:mseries",
    "vega:vvd:intel": "pnpm --filter @multitv/vega run vvd:intel",
    "vega:firetv": "pnpm --filter @multitv/vega run firetv",
    "expotv": "pnpm --filter @multitv/expotv",
    "expotv:prebuild": "pnpm --filter @multitv/expotv run prebuild:tv",
    "expotv:android": "pnpm --filter @multitv/expotv run android",
    "expotv:ios": "pnpm --filter @multitv/expotv run ios",
    "expotv:web": "pnpm --filter @multitv/expotv run web"
  },
  "private": true,
  "packageManager": "pnpm@12.4.2"
}
