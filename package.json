    "@expo/cli@npm:55.0.30": "patch:@expo/cli@npm%3A55.0.36#~/.yarn/patches/@expo-cli-npm-55.0.36-21eff95a7a.patch",
    "@expo/cli@npm:55.0.36": "patch:@expo/cli@npm%3A55.0.36#~/.yarn/patches/@expo-cli-npm-55.0.36-21eff95a7a.patch",
