{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "vega": {
      "config": "vega-build.yml",
      "withoutCredentials": true,
      "corepack": true,
      "env": {
        "VEGA_SDK_VERSION": "0.24.9914",
        "VEGA_BUILD_TYPE": "debug"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
