{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "android": {
        "resourceClass": "large",
        "image": "latest"
      },
      "ios": {
        "resourceClass": "large",
        "image": "latest"
      },
      "corepack": true,
      "withoutCredentials": true,
      "distribution": "internal"
    },
    "vega": {
      "extends": "base",
      "config": "vega-build.yml",
      "env": {
        "VEGA_SDK_VERSION": "0.24.9914"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
