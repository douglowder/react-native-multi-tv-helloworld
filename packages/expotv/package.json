{
  "name": "@multitv/expotv",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android",
    "ios": "EXPO_TV=1 expo run:ios",
    "web": "expo start --web",
    "reset-project": "./scripts/reset-project.js",
    "lint": "expo lint",
    "prebuild": "expo prebuild --clean",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@expo/log-box": "58.0.3",
    "@expo/vector-icons": "^15.0.2",
    "@multitv/shared": "*",
    "expo": "58.0.0-preview.3",
    "expo-build-properties": "~58.0.3",
    "expo-constants": "~58.0.3",
    "expo-font": "~58.0.1",
    "expo-linking": "~58.0.3",
    "expo-router": "~58.0.4",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-system-ui": "~58.0.1",
    "expo-web-browser": "~58.0.0",
    "lottie-react-native": "~7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.87-stable",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  },
  "private": true
}
